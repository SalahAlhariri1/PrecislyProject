# brief.dev — Environment Variables
# Copy this file to .env.local and fill in your API keys

# Anthropic Claude API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Finnhub API key — free tier at https://finnhub.io (60 calls/min, no daily cap)
FINNHUB_API_KEY=

# NewsAPI key — free tier at https://newsapi.org/register
NEWS_API_KEY=
