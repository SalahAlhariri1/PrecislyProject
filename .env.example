# brief.dev — Environment Variables
# Copy this file to .env.local and fill in your API keys

# ── AI + Research APIs ────────────────────────────────────────────────────────

# Anthropic Claude API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Finnhub API key — free tier at https://finnhub.io (60 calls/min, no daily cap)
FINNHUB_API_KEY=

# NewsAPI key — free tier at https://newsapi.org/register
NEWS_API_KEY=

# Tavily API key — web search for the agent at https://tavily.com
TAVILY_API_KEY=

# ── Auth: Clerk ───────────────────────────────────────────────────────────────
# Create a free app at https://dashboard.clerk.com
# After creating, set allowed redirect URLs: http://localhost:3000

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk redirect URLs (keep these as-is for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Database: Supabase ────────────────────────────────────────────────────────
# Create a free project at https://app.supabase.com
# Run supabase/schema.sql in the SQL editor after creating the project

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Notifications: Slack (Phase 4) ────────────────────────────────────────────
# Slack app OAuth credentials — set up at https://api.slack.com/apps
# Required scopes: chat:write, im:write, channels:read

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
